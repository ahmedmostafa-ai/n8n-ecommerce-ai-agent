    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\nSELECT\n    ch.id AS checkout_id,\n    ch.status,\n    ch.product_id,\n    ch.quantity,\n    ch.delivery_address,\n    ch.expires_at,\n    p.name AS product_name,\n    p.price * ch.quantity AS total_amount\nFROM checkout_sessions ch\nJOIN customers c ON c.id = ch.customer_id\nJOIN products p ON p.id = ch.product_id\nWHERE c.telegram_id = $1::BIGINT\n  AND ch.status = 'awaiting_confirmation'\n  AND ch.expires_at > NOW()\nORDER BY ch.created_at DESC, ch.id DESC\nLIMIT 1;\n",
        "options": {
          "queryReplacement": "={{ [$('Telegram Trigger').first().json.message.from.id] }}"
        }
